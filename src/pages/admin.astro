---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readJsonDir, isPublished, sortEvents } from '../lib/content';

const events = sortEvents(readJsonDir('src/content/events').filter(isPublished));
const pastEvents = events.filter((event) => event.status === 'past');
const upcomingEvents = events.filter((event) => event.status === 'upcoming');
const albums = readJsonDir('src/content/gallery').filter(isPublished);
const eventAlbums = albums.filter((album) => album.eventSlug);
const generalAlbums = albums.filter((album) => !album.eventSlug);

const videoOptions = [
  { id: 'video-1', title: 'Sheila speaks — a conversation moment.' },
  { id: 'video-2', title: 'A fabulous moment with the community.' },
  { id: 'video-3', title: 'Behind the scenes with A Sheila Bruce Affair.' }
];
---
<BaseLayout title="Admin | A Sheila Bruce Affair"><section data-admin class="admin-shell"><h1>Admin</h1><div data-login><p class="lead">Private low-friction admin. Enter the site password.</p><form class="form" data-login-form><input name="password" type="password" placeholder="Password" required><button class="btn" type="submit">Enter Admin</button></form></div><div data-dashboard hidden><p class="lead">Create, publish, unpublish, republish, delete, and feature content. Local mode saves in this browser for testing; production mode commits to GitHub through Cloudflare.</p><div class="admin-tabs"><button data-target="#add-event">Add Event</button><button data-target="#add-album">Add Gallery Album</button><button data-target="#add-post">Add Inspiration Post</button><button data-target="#manage">Manage Content</button><button data-target="#feature">Homepage Feature</button></div><section id="add-event" class="admin-panel active"><h2>Add Event</h2><form class="form" data-create-event><input name="title" placeholder="Event title" required><select name="status"><option value="upcoming">Upcoming</option><option value="past">Past</option></select><input name="date" type="date"><input name="displayDate" placeholder="Display date"><input name="location" placeholder="Location"><label class="admin-field-label" for="eventCategory">Event type</label><select id="eventCategory" name="category"><option>Signature Boat / Yacht Experience</option><option>Formal Ball / Gala</option><option>Dinner & Cocktails</option><option>Wellness Conversation</option><option>Women’s Empowerment</option><option>Wealth / Finance Event</option><option>Seasonal Soirée</option><option>Private Affair</option><option>Community Gathering</option><option>Other</option></select><p class="small-note">Choose the closest event type. Use Other if none of the listed types fit.</p><input name="series" placeholder="Series"><textarea name="summary" placeholder="Short summary" required></textarea><textarea name="description" placeholder="Full description"></textarea><input name="media" type="file" accept="image/*,video/mp4,video/quicktime" multiple><select name="registrationType"><option value="none">No registration yet</option><option value="external">External registration link</option><option value="email">Email Sheila</option><option value="payment_instructions">Payment instructions only</option></select><input name="registrationUrl" placeholder="Registration URL"><label class="admin-field-label">Registration QR Code</label><input name="registrationQr" type="file" accept="image/png,image/jpeg,image/jpg,image/webp"><p class="small-note">Optional. Upload the QR code image from the event registration platform. It will appear with the registration button on upcoming event pages.</p><input name="registrationLabel" placeholder="Button label default Register Now"><button class="btn" type="submit">Publish Event</button></form></section><section id="add-album" class="admin-panel"><h2>Add Gallery Album</h2><form class="form" data-create-album><input name="title" placeholder="Album title" required><textarea name="description" placeholder="Album description"></textarea><input name="caption" placeholder="Optional caption"><input name="media" type="file" accept="image/*,video/mp4,video/quicktime" multiple><button class="btn" type="submit">Publish Album</button></form></section><section id="add-post" class="admin-panel"><h2>Add Inspiration Post</h2><form class="form" data-create-post><input name="title" placeholder="Post title" required><select name="category"><option>Sarasota Style</option><option>Event Ideas</option><option>What to Wear</option><option>Past Affairs</option><option>Wellness & Midlife</option><option>Wealth & Confidence</option><option>Hosting Notes</option><option>Community & Culture</option></select><input name="summary" placeholder="Summary" required><textarea name="body" placeholder="Post body" required></textarea><input name="featuredImageFile" type="file" accept="image/*"><button class="btn" type="submit">Publish Post</button></form></section><section id="manage" class="admin-panel"><h2>Manage Content</h2><button class="btn" data-manage-refresh>Refresh Local Test Content</button><div data-manage-list class="event-list"></div></section><section id="feature" class="admin-panel"><h2>Homepage Feature</h2><p class="small-note">Choose the event, gallery album, or video Sheila wants to spotlight on the homepage. This list is generated from the same content files that power the public site.</p><form class="form" data-feature-form><label class="admin-field-label" for="homepageFeatureChoice">Featured homepage item</label><select id="homepageFeatureChoice" name="featureChoice" data-feature-choice required><option value="">Choose an event, album, or video</option><optgroup label="Upcoming events" data-feature-upcoming-events>{upcomingEvents.map((event) => <option value={`event:${event.slug}`}>Event — {event.title}</option>)}</optgroup><optgroup label="Past events" data-feature-events>{pastEvents.map((event) => <option value={`event:${event.slug}`}>Event — {event.title}</option>)}</optgroup><optgroup label="Event gallery albums" data-feature-albums>{eventAlbums.map((album) => <option value={`album:${album.slug}`}>Album — {album.title}</option>)}</optgroup><optgroup label="General gallery albums" data-feature-general-albums>{generalAlbums.map((album) => <option value={`album:${album.slug}`}>Album — {album.title}</option>)}</optgroup><optgroup label="Video moments" data-feature-videos>{videoOptions.map((video) => <option value={`video:${video.id}`}>Video — {video.title}</option>)}</optgroup></select><p class="small-note">Past events, upcoming events, and event albums now flow from the backend content source. No manual slug list needed.</p><button class="btn" type="submit">Set Feature</button></form></section><div class="status-box" data-admin-status>Ready.</div></div></section></BaseLayout>
