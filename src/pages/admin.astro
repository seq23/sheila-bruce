---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Admin | A Sheila Bruce Affair"><section data-admin class="admin-shell"><h1>Admin</h1><div data-login><p class="lead">Private low-friction admin. Enter the site password.</p><form class="form" data-login-form><input name="password" type="password" placeholder="Password" required><button class="btn" type="submit">Enter Admin</button></form></div><div data-dashboard hidden><p class="lead">Create, publish, unpublish, republish, delete, and feature content. Local mode saves in this browser for testing; production mode commits to GitHub through Cloudflare.</p><div class="admin-tabs"><button data-target="#add-event">Add Event</button><button data-target="#add-album">Add Gallery Album</button><button data-target="#add-post">Add Inspiration Post</button><button data-target="#manage">Manage Content</button><button data-target="#feature">Homepage Feature</button></div><section id="add-event" class="admin-panel active"><h2>Add Event</h2><form class="form" data-create-event><input name="title" placeholder="Event title" required><select name="status"><option value="upcoming">Upcoming</option><option value="past">Past</option></select><input name="date" type="date"><input name="displayDate" placeholder="Display date"><input name="location" placeholder="Location"><select name="category"><option>Signature Boat / Yacht Experience</option><option>Formal Ball / Gala</option><option>Dinner & Cocktails</option><option>Wellness Conversation</option><option>Women’s Empowerment</option><option>Wealth / Finance Event</option><option>Seasonal Soirée</option><option>Private Affair</option><option>Community Gathering</option><option>Other</option></select><input name="series" placeholder="Series"><textarea name="summary" placeholder="Short summary" required></textarea><textarea name="description" placeholder="Full description"></textarea><input name="media" type="file" accept="image/*,video/mp4,video/quicktime" multiple><select name="registrationType"><option value="none">No registration yet</option><option value="external">External registration link</option><option value="email">Email Sheila</option><option value="payment_instructions">Payment instructions only</option></select><input name="registrationUrl" placeholder="Registration URL"><input name="registrationLabel" placeholder="Button label default Register Now"><button class="btn" type="submit">Publish Event</button></form></section><section id="add-album" class="admin-panel"><h2>Add Gallery Album</h2><form class="form" data-create-album><input name="title" placeholder="Album title" required><textarea name="description" placeholder="Album description"></textarea><input name="caption" placeholder="Optional caption"><input name="media" type="file" accept="image/*,video/mp4,video/quicktime" multiple><button class="btn" type="submit">Publish Album</button></form></section><section id="add-post" class="admin-panel"><h2>Add Inspiration Post</h2><form class="form" data-create-post><input name="title" placeholder="Post title" required><select name="category"><option>Sarasota Style</option><option>Event Ideas</option><option>What to Wear</option><option>Past Affairs</option><option>Wellness & Midlife</option><option>Wealth & Confidence</option><option>Hosting Notes</option><option>Community & Culture</option></select><input name="summary" placeholder="Summary" required><textarea name="body" placeholder="Post body" required></textarea><input name="featuredImageFile" type="file" accept="image/*"><button class="btn" type="submit">Publish Post</button></form></section><section id="manage" class="admin-panel"><h2>Manage Content</h2><button class="btn" data-manage-refresh>Refresh Local Test Content</button><div data-manage-list class="event-list"></div></section><section id="feature" class="admin-panel"><h2>Homepage Feature</h2><form class="form" data-feature-form><input name="slug" placeholder="Event, album, or video slug/id"><select name="type"><option value="event">Event</option><option value="album">Album</option><option value="video">Video</option></select><button class="btn" type="submit">Set Feature</button></form></section><div class="status-box" data-admin-status>Ready.</div></div></section></BaseLayout>
