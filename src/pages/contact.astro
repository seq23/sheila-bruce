---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { socials } from '../data/social';
---
<BaseLayout title="Contact | A Sheila Bruce Affair">
  <section class="hero contact-hero">
    <div>
      <p class="eyebrow">Let’s plan something fabulous</p>
      <h1>Contact Sheila</h1>
      <p class="lead">Ask about future events, guest list updates, or having Sheila host an affair for your group.</p>
    </div>
    <div class="hero-card contain-media"><img src="/assets/brand/sheila/sheila-glasses-portrait.png" alt="Sheila Bruce smiling"></div>
  </section>

  <section>
    <div class="section-title">
      <h2>How would you like to connect?</h2>
      <p class="lead">Send a direct message or join the guest list for future updates.</p>
    </div>
    <div class="grid two contact-options">
      <div class="card contact-card">
        <span class="pill">General contact</span>
        <h2>Contact Us</h2>
        <p>For questions about future events, past affairs, tickets, payment, guest list updates, or general messages.</p>
        <a class="btn" href={`mailto:${site.email}?subject=General%20question%20for%20A%20Sheila%20Bruce%20Affair`}>Send a Message</a>
      </div>
      <div class="card contact-card featured-contact-card">
        <span class="pill">Guest list</span>
        <h2>Keep in Touch</h2>
        <p>Be the first to hear about future affairs, elegant gatherings, and Fabulous moments from A Sheila Bruce Affair.</p>
        <form class="form compact-form" data-email-list-form>
          <input name="name" type="text" autocomplete="name" placeholder="Your name" required>
          <input name="email" type="email" autocomplete="email" placeholder="Your email" required>
          <button class="btn" type="submit">Join the List</button>
          <p class="small-note" data-subscribe-status aria-live="polite">Your information is saved to Sheila’s private guest-list sheet.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="dark contact-direct">
    <div class="section-title">
      <h2>Direct details</h2>
      <p class="lead">Email, text, or follow along for future fabulous affairs.</p>
    </div>
    <div class="grid two">
      <div class="card">
        <h3>Email</h3>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="card">
        <h3>Text / RSVP</h3>
        <p><a href={`tel:${site.phone}`}>{site.phone}</a></p>
      </div>
    </div>
    <div class="btns social-contact-links">
      {socials.map(s=><a class="btn secondary" href={s.url} target="_blank">{s.label}</a>)}
    </div>
  </section>
</BaseLayout>
