---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readJsonDir, isPublished, sortEvents } from '../lib/content';
const events=sortEvents(readJsonDir('src/content/events').filter(isPublished));
const upcoming=events.filter(e=>e.status==='upcoming');
const past=events.filter(e=>e.status==='past').reverse();
const categories=[...new Set(past.map(e=>e.category))];
---
<BaseLayout title="Events & Past Affairs | A Sheila Bruce Affair">
  <section class="hero">
    <div>
      <p class="eyebrow">Affairs worth dressing up for</p>
      <h1>Events</h1>
      <p class="lead">From signature boat experiences and formal celebrations to wellness conversations and empowerment evenings, A Sheila Bruce Affair creates fabulous moments where community, culture, and luxury meet.</p>
    </div>
    <div class="hero-card"><img src="/assets/brand/sheila/sheila-boat-white.jpg" alt="Sheila Bruce aboard a boat affair"></div>
  </section>

  <section>
    <div class="section-title"><h2>Upcoming Events</h2></div>
    {upcoming.length===0 && <div class="empty"><h3>New fabulous affairs are being planned.</h3><p>No upcoming events have been provided yet. Explore past affairs, or contact Sheila to be added to the list.</p><div class="btns"><a class="btn" href="/contact">Contact Sheila</a><a class="btn secondary" href="/contact?intent=host_event_inquiry">Have Sheila Host an Event</a></div></div>}
    <div data-local-events></div>
  </section>

  <section class="dark past-affairs-section">
    <div class="section-title">
      <div>
        <p class="eyebrow">Past Affairs</p>
        <h2>Archive of fabulous gatherings</h2>
      </div>
      <p>{past.length} archive events</p>
    </div>
    <div class="event-list event-list--cards">
      {past.map(ev=><article class="event-card event-card--archive">
        <a class="event-card__media" href={`/events/${ev.slug}`} aria-label={`View ${ev.title}`}><img src={ev.featuredImage} alt={ev.title}></a>
        <div class="event-card__content">
          <span class="pill event-category-pill">{ev.category}</span>
          <h3 class="event-card__title">{ev.title}</h3>
          <p class="event-card__meta">{ev.displayDate} · {ev.location}</p>
          <p class="event-card__description">{ev.summary}</p>
          <a class="btn" href={`/events/${ev.slug}`}>View Past Affair</a>
        </div>
      </article>)}
    </div>
  </section>

  <section>
    <div class="section-title"><h2>Signature series</h2></div>
    <div class="grid">{categories.map(c=><div class="card"><span class="pill">Series</span><h3>{c}</h3><p>Explore archive moments and future gatherings in this lane.</p></div>)}</div>
  </section>
</BaseLayout>
