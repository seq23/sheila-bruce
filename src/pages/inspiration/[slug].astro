---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readMarkdownDir } from '../../lib/content';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';
export function getStaticPaths(){return readMarkdownDir('src/content/insights').map(post=>({params:{slug:post.slug}, props:{post}}));}
const { post }=Astro.props;
---
<BaseLayout title={`${post.title} | A Sheila Bruce Affair`} description={post.summary} schema={[articleSchema(post),breadcrumbSchema([{name:'Home',url:'/'},{name:'Inspiration',url:'/inspiration'},{name:post.title,url:`/inspiration/${post.slug}`}])]}><section class="hero"><div><p class="eyebrow">{post.category}</p><h1>{post.title}</h1><p class="lead">{post.summary}</p></div><div class="hero-card"><img src={post.featuredImage} alt={post.title}></div></section><section><article class="card" set:html={post.body.replace(/\n/g,'<br>')}></article></section></BaseLayout>
