---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readJsonDir } from '../../lib/content';
import { eventSchema, breadcrumbSchema } from '../../lib/schema';
export function getStaticPaths(){ return readJsonDir('src/content/events').map(ev=>({params:{slug:ev.slug}, props:{ev}})); }
const { ev } = Astro.props;
const albums=readJsonDir('src/content/gallery'); const album=albums.find(a=>a.slug===ev.galleryAlbumSlug);
const heroClass = String(ev.featuredImage).includes('/flyers/') ? 'hero-card contain-media' : 'hero-card';
const mediaClass = (m) => `album-card ${m.type==='video'?'video-card':''} ${String(m.src).includes('/flyers/')?'flyer':''}`;
---
<BaseLayout title={`${ev.title} | A Sheila Bruce Affair`} description={ev.summary} schema={[eventSchema(ev),breadcrumbSchema([{name:'Home',url:'/'},{name:'Events',url:'/events'},{name:ev.title,url:`/events/${ev.slug}`}])]}>
  <section class="hero event-detail-hero">
    <div>
      <p class="eyebrow">{ev.series}</p>
      <span class="pill event-category-pill">{ev.category}</span>
      <h1>{ev.title}</h1>
      <p class="lead">{ev.summary}</p>
      <div class="btns"><a class="btn" href="/gallery">See Gallery</a><a class="btn secondary" href="/contact">Inquire About Future Events</a></div>
    </div>
    <div class={heroClass}><img src={ev.featuredImage} alt={ev.title}></div>
  </section>
  <section>
    <div class="grid two">
      <div class="card"><h2>Details</h2><p><b>Date:</b> {ev.displayDate}</p><p><b>Time:</b> {ev.startTime} {ev.endTime&&`– ${ev.endTime}`}</p><p><b>Location:</b> {ev.location}</p><p><b>Category:</b> {ev.category}</p><p><b>Attire:</b> {ev.attire}</p><p><b>Ticket note:</b> {ev.ticketInfo||'Archive event.'}</p></div>
      <div class="card"><h2>About this affair</h2><p>{ev.description}</p>{ev.panelists?.length>0&&<><h3>Panelists</h3><ul>{ev.panelists.map(p=><li>{p}</li>)}</ul></>}{ev.speakers?.length>0&&<><h3>Speakers</h3><ul>{ev.speakers.map(p=><li>{p}</li>)}</ul></>}</div>
    </div>
  </section>
  {album&&<section class="dark"><div class="section-title"><h2>Gallery moments</h2><a class="btn" href="/gallery">Open Gallery</a></div><div class="album-grid">{album.media.filter(m=>m.published!==false).slice(0,6).map(m=><article class={mediaClass(m)}>{m.type==='video'?<video controls playsinline preload="metadata" poster={m.poster}><source src={m.src} type="video/mp4" /></video>:<img src={m.src} alt={m.alt||m.caption}/>}<div class="overlay"><h3>{m.caption||album.title}</h3></div></article>)}</div></section>}
</BaseLayout>
