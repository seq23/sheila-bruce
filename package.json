{
  "name": "sheila-bruce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "npm run validate:links && npm run validate:admin && npm run validate:secrets && npm run validate:assets",
    "validate:all": "npm run build && npm run validate && npm run test:gauntlet",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:admin": "node scripts/validate-admin-contract.mjs",
    "validate:secrets": "node scripts/validate-no-secrets.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test:e2e": "playwright test",
    "test:gauntlet": "playwright test tests/e2e/master-gauntlet.spec.ts",
    "review": "astro dev",
    "review:built": "npm run build && astro preview",
    "test:gauntlet:headed": "playwright test tests/e2e/master-gauntlet.spec.ts --headed",
    "test:ui": "playwright test --ui",
    "test": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
